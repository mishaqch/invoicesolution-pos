# Backend env. Used when running manage.py / pytest outside docker compose.
# In compose, these come from docker-compose.yml + the root .env.

DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://pos:pos_dev_password@localhost:5432/pos
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
TIME_ZONE=Asia/Karachi
