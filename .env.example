# ===========================================================================
# Root-level env consumed by docker-compose.yml.
# Copy to `.env` (which is gitignored) and replace placeholder values.
# Per-app .env.example files live in backend/, admin-web/, pos-terminal/.
# ===========================================================================

# Postgres password used by both the postgres service and the backend's
# DATABASE_URL. Pick anything in dev; required to be strong in prod.
POSTGRES_PASSWORD=pos_dev_password

# Django secret key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret
