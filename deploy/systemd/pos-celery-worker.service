[Unit]
Description=POS Celery worker
After=network.target redis.service postgresql.service
Wants=redis.service postgresql.service

[Service]
Type=simple
User=pos
Group=pos
WorkingDirectory=/srv/pos/backend
EnvironmentFile=/etc/pos/backend.env
ExecStart=/srv/pos/venv/bin/celery -A core worker \
    --concurrency=2 \
    --loglevel=info \
    --logfile=/var/log/pos/celery-worker.log
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
