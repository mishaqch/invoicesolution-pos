# Sample env file for production. Place at /etc/pos/backend.env on the
# VPS (chmod 640, owner pos:pos). DO NOT commit a filled-in copy of
# this — the FBR token encryption key is in here, and that key
# protects every taxpayer token.

# Django
DJANGO_SETTINGS_MODULE=core.settings.prod
DJANGO_SECRET_KEY=replace-me-with-50-chars-of-random
DJANGO_ALLOWED_HOSTS=pos.example.com
DJANGO_DEBUG=0

# Postgres
DATABASE_URL=postgres://pos:CHANGE_ME@localhost:5432/pos

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# FBR token encryption — 44-char base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates every stored FbrToken. Plan migrations
# carefully if you ever rotate.
FBR_TOKEN_ENC_KEY=replace-me

# Email (notifications, day-close summaries)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=mailer@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Pakistan POS <noreply@example.com>

# Error tracking (optional — Glitchtip self-hosted)
GLITCHTIP_DSN=

# Backup (used by deploy/scripts/backup_to_b2.sh — separate file)
# B2_BUCKET=pos-backups
# B2_KEY_ID=000xxx
# B2_APP_KEY=CHANGE_ME
# GPG_RECIPIENT=ABCD1234
